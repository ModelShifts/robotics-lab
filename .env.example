# robotics-lab example configuration. Copy to .env and edit.
# This project does not call a language model. There is no MS_BACKEND.

# --- CAN bus ---
# virtual needs no hardware. socketcan needs an existing channel such as vcan0.
CAN_INTERFACE=virtual
CAN_CHANNEL=robotlab
CAN_BITRATE=500000
CAN_DBC_FILE=samples/can/robot.dbc

# --- ROS 2 bag analysis (no ROS install required) ---
ROS_BAG=samples/ros/node_graph
